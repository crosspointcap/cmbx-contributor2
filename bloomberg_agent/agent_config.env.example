# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_service_role_key

# ── Bloomberg mode ────────────────────────────────────────────────────
# BBG_MODE=stub  → logs to bbg_publish_log.txt, no Bloomberg connection needed
# BBG_MODE=live  → connects to Bloomberg Terminal/B-Pipe via BLPAPI
BBG_MODE=stub

# ── Bloomberg connection (live mode only) ────────────────────────────
# BBG_HOST: IP of the machine running Bloomberg Terminal or B-Pipe
# BBG_PORT: Bloomberg API port (default 8194)
BBG_HOST=localhost
BBG_PORT=8194

# ── Your Bloomberg GPGX credentials (get from Bloomberg Sales) ───────
# BBG_CONTRIBUTOR_ID : your firm's contributor ID (e.g. 8563)
# BBG_GPGX_ID        : your firm's GPGX ID (e.g. 431)
# BBG_GPGX_MONITOR   : monitor number assigned to your page (usually 1)
# BBG_GPGX_PAGE      : page number within that monitor (usually 1)
# BBG_PRODUCT_CODE   : product code from Bloomberg (usually 1)
# BBG_GPGX_SERVICE   : use //blp-test/c-gpgx for test, //blp/mpfbapi for prod
BBG_CONTRIBUTOR_ID=8563
BBG_GPGX_ID=431
BBG_GPGX_MONITOR=1
BBG_GPGX_PAGE=1
BBG_PRODUCT_CODE=1
BBG_GPGX_SERVICE=//blp-test/c-gpgx
